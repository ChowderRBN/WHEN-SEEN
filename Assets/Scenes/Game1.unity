    soundEffect: {fileID: 0}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.5
  - speakerName: Rudy
    dialogueText: Yes ma'am.
    voiceClip: {fileID: 0}
    soundEffect: {fileID: 0}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.5
  - speakerName: 
    dialogueText: ...
    voiceClip: {fileID: 0}
    soundEffect: {fileID: 0}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.5
  - speakerName: 
