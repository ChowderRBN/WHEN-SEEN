    voiceClip: {fileID: 0}
    soundEffect: {fileID: 0}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.5
  - speakerName: Rudy
    dialogueText: No way.
    voiceClip: {fileID: 0}
    soundEffect: {fileID: 0}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.5
  - speakerName: Everyone
    dialogueText: Surprise!!!
    voiceClip: {fileID: 8300000, guid: 067b13a4b860b1e458c64f169e211fe9, type: 3}
    soundEffect: {fileID: 0}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.5
  - speakerName: Trish
    dialogueText: Happy Birthday, Rudy.
    voiceClip: {fileID: 8300000, guid: 56746de8321fd4f4781f2c08a6595ffb, type: 3}
    soundEffect: {fileID: 0}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.5
  - speakerName: Casey
    dialogueText: Yeah! Happy Birthday Man.
    voiceClip: {fileID: 8300000, guid: f731a9cb36394e8498b1d47609d54e1d, type: 3}
    soundEffect: {fileID: 0}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.5
  - speakerName: Carter
    dialogueText: 'It was MY idea to get you that cake. '
    voiceClip: {fileID: 8300000, guid: 7a067cbe95286b54c853afb9db9d1a70, type: 3}
    soundEffect: {fileID: 0}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.5
  - speakerName: Rudy
    dialogueText: Thank you so much guys.
    voiceClip: {fileID: 0}
    soundEffect: {fileID: 0}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.5
  - speakerName: Trish
    dialogueText: You deserve it.
    voiceClip: {fileID: 8300000, guid: 56746de8321fd4f4781f2c08a6595ffb, type: 3}
    soundEffect: {fileID: 0}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.5
  - speakerName: 
    dialogueText: 
    voiceClip: {fileID: 8300000, guid: 75446a74f7b8f124fa41770c52580ab6, type: 3}
    soundEffect: {fileID: 8300000, guid: 75446a74f7b8f124fa41770c52580ab6, type: 3}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 2
    useScreenShake: 1
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 1
    flashIntensity: 0.5
  - speakerName: Carter
    dialogueText: Why are the sirens going off? We're not supposed to be near anything
      yet?!?
    voiceClip: {fileID: 8300000, guid: 4aea144b62450c34daa04737953dd223, type: 3}
    soundEffect: {fileID: 8300000, guid: 75446a74f7b8f124fa41770c52580ab6, type: 3}
