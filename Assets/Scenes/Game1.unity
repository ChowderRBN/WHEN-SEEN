    autoAdvanceDelay: 2.5
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 1
    flashIntensity: 0.5
  - speakerName: Trish
    dialogueText: What the-everyone get to the bridge, NOW!
    voiceClip: {fileID: 8300000, guid: f0b23780913b9a34b894357eec3ab75f, type: 3}
    soundEffect: {fileID: 8300000, guid: 75446a74f7b8f124fa41770c52580ab6, type: 3}
