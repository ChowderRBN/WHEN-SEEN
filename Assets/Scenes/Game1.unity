  textSpeed: 0.02
  nextSceneName: Game2
  dialogueLines:
  - speakerName: MISSION LOG - DAY 247
    dialogueText: 'En route to Colony Osiris via Astra Linear wormhole. ETA: 6 hours.'
    voiceClip: {fileID: 0}
    soundEffect: {fileID: 0}
    customTextSpeed: 0.02
    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.5
  - speakerName: Trish
    dialogueText: Rudy, wake up. We're approaching the wormhole. Need you at your
      station.
    voiceClip: {fileID: 8300000, guid: 004adde9237f82f439627c63494e3cee, type: 3}
    soundEffect: {fileID: 0}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.5
  - speakerName: Rudy
    dialogueText: ...Copy that, Captain. On my way.
    voiceClip: {fileID: 0}
    soundEffect: {fileID: 0}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.5
  - speakerName: Carter
    dialogueText: Morning, sunshine. Sleep well?
    voiceClip: {fileID: 8300000, guid: 7a067cbe95286b54c853afb9db9d1a70, type: 3}
    soundEffect: {fileID: 0}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.5
  - speakerName: Rudy
    dialogueText: Like a rock. What's our status?
    voiceClip: {fileID: 0}
    soundEffect: {fileID: 0}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.5
  - speakerName: Casey
    dialogueText: All systems greener than my 3's. Should be a smooth jump through
      Astra Linear.
    voiceClip: {fileID: 8300000, guid: 295aa24b39bb9824ea073bc889419284, type: 3}
    soundEffect: {fileID: 0}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.5
  - speakerName: Trish
    dialogueText: 'You''ve never made a three in your LIFE! '
    voiceClip: {fileID: 8300000, guid: f0b23780913b9a34b894357eec3ab75f, type: 3}
    soundEffect: {fileID: 0}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.5
  - speakerName: Trish
    dialogueText: Anyways. Casey, did you finish the equipment check?
    voiceClip: {fileID: 8300000, guid: f0b23780913b9a34b894357eec3ab75f, type: 3}
    soundEffect: {fileID: 0}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.5
  - speakerName: Casey
    dialogueText: Oh! Yes, Captain. All... equipment is ready.
    voiceClip: {fileID: 8300000, guid: bd5e561a577cd5e419c98c8e7abefb22, type: 3}
    soundEffect: {fileID: 0}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.05
  - speakerName: Carter
    dialogueText: I'd like to say. I believe him.
    voiceClip: {fileID: 8300000, guid: 7a067cbe95286b54c853afb9db9d1a70, type: 3}
    soundEffect: {fileID: 0}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.5
  - speakerName: Trish
    dialogueText: Then you can go help him check.
    voiceClip: {fileID: 8300000, guid: f0b23780913b9a34b894357eec3ab75f, type: 3}
    soundEffect: {fileID: 0}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.5
  - speakerName: Carter
    dialogueText: ... He didn't do a thing.
    voiceClip: {fileID: 8300000, guid: 7a067cbe95286b54c853afb9db9d1a70, type: 3}
    soundEffect: {fileID: 0}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.5
  - speakerName: Casey
    dialogueText: Bruh
    voiceClip: {fileID: 8300000, guid: f731a9cb36394e8498b1d47609d54e1d, type: 3}
    soundEffect: {fileID: 0}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.5
  - speakerName: Trish
    dialogueText: Go check the equipment.
    voiceClip: {fileID: 8300000, guid: 56746de8321fd4f4781f2c08a6595ffb, type: 3}
    soundEffect: {fileID: 0}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.5
  - speakerName: Casey
    dialogueText: Yes ma'am...
    voiceClip: {fileID: 8300000, guid: f731a9cb36394e8498b1d47609d54e1d, type: 3}
    soundEffect: {fileID: 0}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.5
  - speakerName: Trish
    dialogueText: Rudy. Head to the kitchen and prepare breakfast.
