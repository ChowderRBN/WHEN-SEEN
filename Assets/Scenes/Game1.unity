    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.5
  - speakerName: Trish
    dialogueText: Got it. Start installing it and stick close to me.
    voiceClip: {fileID: 8300000, guid: f0b23780913b9a34b894357eec3ab75f, type: 3}
    soundEffect: {fileID: 0}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.5
  - speakerName: Rudy
    dialogueText: Thank you, Captain
    voiceClip: {fileID: 0}
    soundEffect: {fileID: 0}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.5
  - speakerName: Trish
    dialogueText: Of course.
    voiceClip: {fileID: 8300000, guid: 56746de8321fd4f4781f2c08a6595ffb, type: 3}
    soundEffect: {fileID: 0}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 1
