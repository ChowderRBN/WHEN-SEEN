      course correction.
    voiceClip: {fileID: 0}
    soundEffect: {fileID: 8300000, guid: 75446a74f7b8f124fa41770c52580ab6, type: 3}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 1
    shakeIntensity: 3
    shakeDuration: 0.5
    useRedFlash: 1
    flashIntensity: 0.5
  - speakerName: Trish
    dialogueText: Everyone to stations! NOW!
    voiceClip: {fileID: 0}
    soundEffect: {fileID: 8300000, guid: 75446a74f7b8f124fa41770c52580ab6, type: 3}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 1
    shakeIntensity: 3
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.5
  - speakerName: SHIP AI
    dialogueText: 'CRITICAL Wormhole event detected. Destination: Unknown. Impact
