    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.5
  - speakerName: Carter
    dialogueText: Echolocation works perfectly.
    voiceClip: {fileID: 8300000, guid: 7a067cbe95286b54c853afb9db9d1a70, type: 3}
    soundEffect: {fileID: 0}
    customTextSpeed: 0
    autoAdvance: 0
