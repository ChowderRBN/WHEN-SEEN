    voiceClip: {fileID: 0}
    soundEffect: {fileID: 8300000, guid: 75446a74f7b8f124fa41770c52580ab6, type: 3}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 1
    shakeIntensity: 3
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.5
  - speakerName: Trish
    dialogueText: Carter get us out of here!
    voiceClip: {fileID: 0}
    soundEffect: {fileID: 8300000, guid: 75446a74f7b8f124fa41770c52580ab6, type: 3}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.5
  - speakerName: Carter
    dialogueText: I'm trying! It's pulling us in!
    voiceClip: {fileID: 0}
    soundEffect: {fileID: 8300000, guid: 75446a74f7b8f124fa41770c52580ab6, type: 3}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.5
  - speakerName: Casey
    dialogueText: It's been an honor serving!
    voiceClip: {fileID: 0}
    soundEffect: {fileID: 8300000, guid: 75446a74f7b8f124fa41770c52580ab6, type: 3}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.5
  - speakerName: 
