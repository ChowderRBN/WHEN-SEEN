  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CutsceneManager
  cutscenePanel: {fileID: 1441111652}
  dialogueText: {fileID: 189768535}
  speakerNameText: {fileID: 1363018960}
  fadePanel: {fileID: 342059395}
  flashEffect: {fileID: 2100806928}
  nameInputPanel: {fileID: 1028919370}
  nameInputField: {fileID: 357165032}
  confirmNameButton: {fileID: 649615820}
  namePromptText: {fileID: 157550071}
  voiceSource: {fileID: 215696049}
  sfxSource: {fileID: 1924354363}
  musicSource: {fileID: 1072431654}
  ambientDarkness: {fileID: 8300000, guid: e3ff76263e5d154419447ccbf21cdeb0, type: 3}
  textSpeed: 0.05
  nextSceneName: Game2
  defaultPlayerName: Melvin
  dialogueLines:
  - speakerName: MISSION LOG - DAY 247
    dialogueText: 'En route to Colony Osiris via Astra Linear wormhole. ETA: 6 hours.'
    voiceClip: {fileID: 0}
    soundEffect: {fileID: 0}
    customTextSpeed: 0.02
    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.5
  - speakerName: Trish
    dialogueText: "Up. C\u2019mon. You\u2019re burning daylight, kid."
    voiceClip: {fileID: 0}
    soundEffect: {fileID: 0}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 2
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.5
  - speakerName: Trish
    dialogueText: We hit the anomaly belt in six hours. I need you functional, not
      cocooned.
    voiceClip: {fileID: 0}
    soundEffect: {fileID: 0}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.5
  - speakerName: '{PLAYER} '
    dialogueText: I have plenty of time. Gimme 5 more minutes.
    voiceClip: {fileID: 0}
    soundEffect: {fileID: 0}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.5
  - speakerName: Trish
    dialogueText: You said that yesterday. And the day before.
    voiceClip: {fileID: 0}
    soundEffect: {fileID: 0}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.5
  - speakerName: '{PLAYER}'
    dialogueText: Ughhhh. Alright.
    voiceClip: {fileID: 0}
    soundEffect: {fileID: 0}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.5
  - speakerName: Trish
    dialogueText: Oh, quit your whining.
    voiceClip: {fileID: 0}
    soundEffect: {fileID: 0}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.5
  - speakerName: '{PLAYER}'
    dialogueText: Yes ma'am.
    voiceClip: {fileID: 0}
    soundEffect: {fileID: 0}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.5
  - speakerName: Trish
    dialogueText: "Good. You\u2019re on breakfast duty. Casey already tried to microwave
      protein paste."
    voiceClip: {fileID: 0}
    soundEffect: {fileID: 0}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.05
  - speakerName: '{PLAYER}'
    dialogueText: "That\u2019s a war crime."
    voiceClip: {fileID: 0}
    soundEffect: {fileID: 0}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.5
  - speakerName: Trish
    dialogueText: Exactly. Move it.
    voiceClip: {fileID: 0}
    soundEffect: {fileID: 0}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.5
  - speakerName: Casey
    dialogueText: Oh wow. Look who decided to join the living.
    voiceClip: {fileID: 0}
    soundEffect: {fileID: 0}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.5
  - speakerName: '{PLAYER}'
    dialogueText: "You\u2019re loud for someone this close to being spaced."
    voiceClip: {fileID: 0}
    soundEffect: {fileID: 0}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.5
  - speakerName: Casey
    dialogueText: Harsh.
    voiceClip: {fileID: 0}
    soundEffect: {fileID: 0}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.5
  - speakerName: Carter
    dialogueText: '{PLAYER} go easy on him. You''re clearly more hard working than
      him.'
    voiceClip: {fileID: 0}
    soundEffect: {fileID: 0}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.5
  - speakerName: '{PLAYER}'
    dialogueText: Low bar.
    voiceClip: {fileID: 0}
    soundEffect: {fileID: 0}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.5
  - speakerName: Casey
    dialogueText: Get a load of this guy.
    voiceClip: {fileID: 0}
    soundEffect: {fileID: 0}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.5
  - speakerName: '{PLAYER}'
    dialogueText: Is that your favorite thing to say?
    voiceClip: {fileID: 0}
    soundEffect: {fileID: 0}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.5
  - speakerName: Carter
    dialogueText: It's all those movies he watched from the 80's.
    voiceClip: {fileID: 0}
    soundEffect: {fileID: 0}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.5
  - speakerName: '{PLAYER}'
    dialogueText: Those old movies? They came out like 200 years ago.
    voiceClip: {fileID: 0}
    soundEffect: {fileID: 0}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.5
  - speakerName: Trish
    dialogueText: '{PLAYER}, eggs. Now.'
    voiceClip: {fileID: 0}
    soundEffect: {fileID: 0}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.5
  - speakerName: '{PLAYER}'
    dialogueText: I can give it a bit of {PLAYER} spice.
    voiceClip: {fileID: 0}
    soundEffect: {fileID: 0}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.5
  - speakerName: Carter
    dialogueText: Quit talking in third person.
    voiceClip: {fileID: 0}
    soundEffect: {fileID: 0}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.5
  - speakerName: Casey
    dialogueText: Definitely not your style bro.
    voiceClip: {fileID: 0}
    soundEffect: {fileID: 0}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.5
  - speakerName: '{PLAYER}'
    dialogueText: Fine. I'll get to it.
    voiceClip: {fileID: 0}
    soundEffect: {fileID: 0}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.5
  - speakerName: 
    dialogueText: 
    voiceClip: {fileID: 0}
    soundEffect: {fileID: 0}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.5
  - speakerName: Everyone
    dialogueText: SURPRISE!
    voiceClip: {fileID: 0}
    soundEffect: {fileID: 0}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.5
  - speakerName: '{PLAYER}'
    dialogueText: Cake in the morning? You didn't have too.
    voiceClip: {fileID: 0}
    soundEffect: {fileID: 0}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 2
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 1
    flashIntensity: 0.5
  - speakerName: Trish
    dialogueText: Yes we did. Casey wouldn't shut up about it.
    voiceClip: {fileID: 0}
    soundEffect: {fileID: 0}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 2.5
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.5
  - speakerName: Casey
    dialogueText: Cake's a little... dense.
    voiceClip: {fileID: 0}
    soundEffect: {fileID: 0}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.5
  - speakerName: Carter
    dialogueText: Not as dense as you. Fatty.
    voiceClip: {fileID: 0}
    soundEffect: {fileID: 0}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.5
  - speakerName: '{PLAYER}'
    dialogueText: Hehe. Fatty.
    voiceClip: {fileID: 0}
    soundEffect: {fileID: 0}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.5
  - speakerName: Trish
    dialogueText: Alright, let's sing happy birthday!
    voiceClip: {fileID: 0}
    soundEffect: {fileID: 0}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.5
  - speakerName: Everyone
    dialogueText: Happy Birthday to you!
    voiceClip: {fileID: 0}
    soundEffect: {fileID: 0}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.5
  - speakerName: Everyone
    dialogueText: Happy Birthday to you!
    voiceClip: {fileID: 0}
    soundEffect: {fileID: 0}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.5
  - speakerName: 'Everyone '
    dialogueText: Happy Birthday dear {PLAYER}!
    voiceClip: {fileID: 0}
    soundEffect: {fileID: 0}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 10
    useRedFlash: 0
    flashIntensity: 0.5
  - speakerName: Everyone
    dialogueText: Happy Birthday to youuu!
    voiceClip: {fileID: 0}
    soundEffect: {fileID: 0}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.5
  - speakerName: Trish
    dialogueText: "No candles to blow out\u2026 but you get the point."
    voiceClip: {fileID: 0}
    soundEffect: {fileID: 0}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.5
  - speakerName: 
    dialogueText: A few hours later.
    voiceClip: {fileID: 0}
    soundEffect: {fileID: 0}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.5
  - speakerName: '{PLAYER}'
    dialogueText: That was awesome guys.
    voiceClip: {fileID: 0}
    soundEffect: {fileID: 0}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.5
  - speakerName: Casey
    dialogueText: That cake was... VERY dense. I couldn't move an inch!
    voiceClip: {fileID: 0}
    soundEffect: {fileID: 0}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.5
  - speakerName: SHIP AI
    dialogueText: 'ALERT Spatial anomaly detected. Distance: 200 kilometers and closing.'
    voiceClip: {fileID: 0}
    soundEffect: {fileID: 8300000, guid: 75446a74f7b8f124fa41770c52580ab6, type: 3}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 0
    shakeIntensity: 3
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.5
  - speakerName: Trish
    dialogueText: What? That can't be right. There's nothing on the charts?
    voiceClip: {fileID: 0}
    soundEffect: {fileID: 8300000, guid: 75446a74f7b8f124fa41770c52580ab6, type: 3}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.5
  - speakerName: SHIP AI
