    autoAdvanceDelay: 1
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 0
    flashIntensity: 0.5
  - speakerName: Trish
    dialogueText: It's linked to your brainwaves. It's like in a video games. Think
