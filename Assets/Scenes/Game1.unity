    autoAdvanceDelay: 1
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 1
    flashIntensity: 0.5
  - speakerName: Rudy
    dialogueText: Captain, what's happening?!
    voiceClip: {fileID: 0}
    soundEffect: {fileID: 8300000, guid: 75446a74f7b8f124fa41770c52580ab6, type: 3}
    customTextSpeed: 0
    autoAdvance: 1
    autoAdvanceDelay: 1
    useScreenShake: 0
    shakeIntensity: 10
    shakeDuration: 0.5
    useRedFlash: 1
    flashIntensity: 0.5
  - speakerName: Casey
    dialogueText: We are about to hit an unmarked wormhole!
    voiceClip: {fileID: 8300000, guid: bd5e561a577cd5e419c98c8e7abefb22, type: 3}
    soundEffect: {fileID: 8300000, guid: 75446a74f7b8f124fa41770c52580ab6, type: 3}
